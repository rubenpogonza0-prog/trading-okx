# OKX API credentials — create a READ-ONLY API key at https://www.okx.com/account/my-api
# This dashboard only reads data; it never places or cancels orders. Do NOT grant
# "Trade" or "Withdraw" permissions to the key you use here.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Set to "1" to hit OKX's demo trading environment instead of the live account.
OKX_DEMO=0

# Port the backend HTTP server listens on
PORT=4000
