# OKX API credentials — create at https://www.okx.com/account/my-api
#
# The dashboard endpoints (/api/balance, /api/positions, /api/orders) only
# ever read data. The trading engine (src/trading/*) places real orders and
# needs the "Trade" permission on this key. NEVER grant "Withdraw" — nothing
# in this project needs it, and it turns a leaked key into a drained wallet.
# Restrict the key to your server's IP in OKX's API management page.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Set to "1" to hit OKX's demo trading environment instead of the live
# account — strongly recommended to run at least one full cycle here before
# pointing the scheduler at real funds.
OKX_DEMO=0

# Port the backend HTTP server listens on
PORT=4000

# Comma-separated list of origins allowed to call the backend API.
CORS_ORIGINS=http://localhost:5173

# Set to "1" to enable the news/fundamental guard (src/trading/newsFilter.js).
# Checks public RSS feeds (CoinDesk, CoinTelegraph, Decrypt) for recent
# market-wide or asset-specific headlines before entering a trade — no API
# key needed. Recommended on.
NEWS_FILTER_ENABLED=1

# Set to "1" to run the autonomous trading engine (real orders) inside this
# same process, on a schedule (default every 10 minutes — see CYCLE_CRON),
# alongside the dashboard API. This is what a 24/7 deployment (e.g. Railway)
# should set to 1. Leave at 0/unset for a read-only local dashboard.
ENABLE_SCHEDULER=0

# Standard cron expression for how often to run a scan/trade cycle.
CYCLE_CRON=*/10 * * * *

# --- Grid trading bot (backend/src/grid/) — see CLAUDE.md for the decision
# rules. All optional; defaults live in src/grid/riskConfig.js.

# ADX(14) below this -> NEUTRAL grid (Bollinger Bands range).
GRID_ADX_NEUTRAL_MAX=20
# ADX(14) at/above this -> directional grid (LONG/SHORT) allowed.
GRID_ADX_TREND_MIN=25
# Hard ceiling. Never raise this past 3 — the strategy spec caps leverage at 3x.
GRID_MAX_LEVERAGE=3
# USDT margin committed per grid deployment.
GRID_MARGIN_USDT=20
