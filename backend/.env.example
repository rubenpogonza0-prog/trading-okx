# OKX API credentials — create at https://www.okx.com/account/my-api
#
# The dashboard endpoints (/api/balance, /api/positions, /api/orders) only
# ever read data. The trading engine (src/trading/*) places real orders and
# needs the "Trade" permission on this key. NEVER grant "Withdraw" — nothing
# in this project needs it, and it turns a leaked key into a drained wallet.
# Restrict the key to your server's IP in OKX's API management page.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Set to "1" to hit OKX's demo trading environment instead of the live
# account — strongly recommended to run at least one full cycle here before
# pointing the scheduler at real funds.
OKX_DEMO=0

# Port the backend HTTP server listens on
PORT=4000

# Comma-separated list of origins allowed to call the backend API.
CORS_ORIGINS=http://localhost:5173

# Set to "1" to enable the news/fundamental guard in src/trading/newsFilter.js
# once you've wired in a real provider — see that file. Defaults to off
# (unchecked) rather than silently pretending to check news.
NEWS_FILTER_ENABLED=0
